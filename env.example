# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Local: mongodb://127.0.0.1:27017/ig-auto-poster
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/ig-auto-poster
MONGO_URI=
GEMINI_API_KEY=your_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image