


# --- Server ---
PORT=5000
NODE_ENV=development
 
# --- MongoDB (local) ---
MONGO_URI=mongodb://localhost:27017/Instagram
 
# --- Instagram API with Instagram Login (no Facebook Page needed) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/auth/instagram/callback

 
# --- Token encryption (32-byte hex key) - already generated for you below ---
TOKEN_ENCRYPTION_KEY=
 
# --- Gemini API --- ritammaty@gmail.com
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
 
# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=b--
 
# --- Scheduler ---
DAILY_POST_CRON=0 9 * * *
TOKEN_REFRESH_CRON=0 3 * * 1
