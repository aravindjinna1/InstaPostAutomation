


# --- Server ---
PORT=5000
NODE_ENV=development
 
# --- MongoDB (local) ---
MONGO_URI=mongodb://localhost:27017/Instagram
MONGO_DB_NAME=AutoInsta
 
# --- Job SOURCE database (data used to post jobs to Instagram) ---
# The posting pipeline reads the next job from this DB/collection.
# Published post records are still stored in AutoInsta / Jobs-posts (Post model).
JOBS_DB_NAME=JobsData_fromBlogs
JOBS_COLLECTION_NAME=New_Jobs
 
# --- Instagram API with Instagram Login (no Facebook Page needed) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/auth/instagram/callback

 
# --- Token encryption (32-byte hex key) - already generated for you below ---
TOKEN_ENCRYPTION_KEY=
 
# --- Gemini API --- ritammaty@gmail.com
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
# Best quality (premium): gemini-3-pro-image. Better speed/cost: gemini-3.1-flash-image.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
 
# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=b--
 
# --- Scheduler ---
# India time (Asia/Kolkata): runs every 30 minutes from 06:00 through 23:30.
# No daily posts run between 00:00 and 05:59.
DAILY_POST_CRON_1=0 6-23 * * *
DAILY_POST_CRON_2=30 6-23 * * *
TOKEN_REFRESH_CRON=0 3 * * 1

# --- Local Reel music ---
# Add permitted .mp3/.m4a/.aac/.wav/.ogg/.flac files to ./music. Files are
# selected in natural filename order and wrap to the first file at the end.
LOCAL_MUSIC_DIRECTORY=music
# Change this only when you deliberately want a separate/reset music rotation.
LOCAL_MUSIC_QUEUE_KEY=local-reel-music
